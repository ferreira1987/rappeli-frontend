# Laravel API used by the Vite dev server proxy (local backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty in production (same origin: https://app.rappeli.com.br).
# VITE_API_BASE_URL=
# CI may set VITE_API_URL → mapped to VITE_API_BASE_URL in deploy workflow.

# Laravel Reverb (required in production builds; embedded in the bundle)
# VITE_REVERB_APP_KEY=local-reverb-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=5173
# VITE_REVERB_SCHEME=http
# VITE_REVERB_PROXY_TARGET=http://127.0.0.1:8080
